{
  "id": "whats2api_bridge",
  "name": "Whats2API Bridge",
  "version": "0.5.0",
  "oxs_version": ">=1.0.0,<2.0.0",
  "python_deps": [],
  "author": {
    "name": "algoz098",
    "url": "https://github.com/algoz098",
    "email": ""
  },
  "license": "AGPL-3.0-or-later",
  "repository": "https://github.com/odysseus-dev/odysseus/tree/main/extensions/whats2api_bridge",
  "description": "WhatsApp via whats2api.com — list/start/stop sessions, send messages and reactions, and ingest every inbound event (messages.upsert, connection.update, group-participants.update, ...) through an OXS webhook.",
  "entry_point": "plugin:register",
  "hooks": [
    "on_install",
    "on_enable",
    "on_disable",
    "on_uninstall"
  ],
  "capabilities": {
    "data": true,
    "tools": true,
    "routes": true,
    "mcp_tools": true,
    "webhooks_in": true,
    "webhooks_out": true,
    "events_sub": [
      "oxs.rescan"
    ],
    "events_fire": [
      "whats2api.message.received",
      "whats2api.message.sent",
      "whats2api.connection.update",
      "whats2api.group.update",
      "whats2api.presence.update",
      "whats2api.call"
    ],
    "ui_panel": true,
    "static": [
      {
        "url_prefix": "/ext-static/whats2api_bridge",
        "directory": "ui"
      }
    ],
    "settings_read": true
  },
  "permissions": {
    "network_outbound": [
      "https://api.whats2api.com"
    ],
    "filesystem_data_subpath": [
      "cache"
    ]
  },
  "privileged_permissions": {},
  "settings_schema": {
    "type": "object",
    "properties": {
      "api_token": {
        "type": "string",
        "title": "API token",
        "description": "Long-lived API token from the whats2api.com dashboard (Dashboard → API Tokens). Shown only once at creation. 64 hex chars.",
        "minLength": 8,
        "maxLength": 256
      },
      "base_url": {
        "type": "string",
        "title": "API base URL",
        "default": "https://api.whats2api.com",
        "description": "Override only if you proxy whats2api.com. Must start with https://.",
        "pattern": "^https://[A-Za-z0-9._\\-/]+$"
      },
      "default_connection_id": {
        "type": "string",
        "title": "Default connection ID",
        "description": "Optional connection to use when a tool call omits connection_id.",
        "maxLength": 128
      },
      "request_timeout_seconds": {
        "type": "integer",
        "title": "HTTP timeout",
        "default": 30,
        "minimum": 1,
        "maximum": 300
      },
      "retention_days": {
        "type": "integer",
        "title": "Event log retention (days)",
        "default": 7,
        "minimum": 1,
        "maximum": 365
      },
      "log_inbound_events": {
        "type": "boolean",
        "title": "Persist every inbound event",
        "default": true,
        "description": "If true, every whats2api event is stored in the events table."
      },
      "inbound_webhook_key": {
        "type": "string",
        "title": "Inbound webhook key (DEPRECATED — kept for back-compat, no UI exposure)",
        "description": "Legacy field, no longer read or enforced. Exists only so old settings files load without error.",
        "maxLength": 256
      },
      "webhook_url_token": {
        "type": "string",
        "title": "Webhook URL token",
        "description": "User-defined token that replaces the auto-generated <token> in /api/ext/whats2api_bridge/webhook/<token>. Type any string; only URL-safe characters (A–Z, a–z, 0–9, '-', '_') are accepted because the value goes into the URL path. Persisted to data/extensions/whats2api_bridge/inbound_webhook_token (mode 0600) and survives restarts; takes effect on the dispatcher immediately after save.",
        "pattern": "^[A-Za-z0-9_-]*$",
        "maxLength": 1024
      }
    },
    "additionalProperties": false,
    "required": [
      "api_token",
      "base_url"
    ]
  },
  "data_schema": {
    "connections": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "name": "TEXT",
        "engine": "TEXT",
        "phone": "TEXT",
        "status": "TEXT",
        "owner_id": "TEXT",
        "raw_json": "TEXT",
        "updated_at": "INTEGER NOT NULL"
      },
      "indexes": [
        [
          "status"
        ],
        [
          "owner_id"
        ]
      ]
    },
    "messages": {
      "columns": {
        "id": "TEXT PRIMARY KEY",
        "connection_id": "TEXT NOT NULL",
        "direction": "TEXT NOT NULL",
        "remote_jid": "TEXT",
        "from_me": "TEXT",
        "chat_jid": "TEXT",
        "sender_jid": "TEXT",
        "push_name": "TEXT",
        "text": "TEXT",
        "message_type": "TEXT",
        "ts": "INTEGER NOT NULL",
        "raw_json": "TEXT"
      },
      "indexes": [
        [
          "connection_id",
          "ts"
        ],
        [
          "chat_jid",
          "ts"
        ],
        [
          "direction"
        ]
      ],
      "unique": [
        [
          "id"
        ]
      ]
    },
    "events": {
      "columns": {
        "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
        "event_name": "TEXT NOT NULL",
        "connection_id": "TEXT",
        "user_id": "TEXT",
        "received_at": "INTEGER NOT NULL",
        "raw_json": "TEXT"
      },
      "indexes": [
        [
          "event_name",
          "received_at"
        ],
        [
          "connection_id",
          "received_at"
        ]
      ]
    }
  },
  "file_hashes": {
    "plugin.py": "sha256:1749f171bdd817ea43f05fa150c43cb862456b4ec9cfd05ad3a4b4592b426ead",
    "ui/index.html": "sha256:86adccf59a1c534b2f6b5bbe0f554a4958b0a588c2c86e0e24e027b37e6a598f"
  }
}
